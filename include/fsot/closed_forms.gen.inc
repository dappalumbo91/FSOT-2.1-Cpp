    return r;
  }

  Results chemistry_radii() const {
    Results r;
    r.push_back(mk("R_H", "ln(2)/\u221a5", (m::ln(R(2)) / m::sqrt(R(5))), lit<R>("0.31")));
    r.push_back(mk("R_C", "\u03c0\u207b\u2074 + \u221a\u03b3", (m::ipow(PI, -4) + m::sqrt(GAMMA)), lit<R>("0.77")));
    r.push_back(mk("R_N", "G\u207b\u2077 \u2212 ln(3)", (m::ipow(G_CAT, -7) - m::ln(R(3))), lit<R>("0.75")));
    r.push_back(mk("R_O", "P_base/\u03b8_S", (P_BASE / THETA_S), lit<R>("0.73")));
    r.push_back(mk("R_F", "\u221a\u03b3 \u2212 e\u207b\u00b3", (m::sqrt(GAMMA) - m::exp((-R(3)))), lit<R>("0.71")));
    r.push_back(mk("R_Na", "\u03b3\u207b\u00b9 \u2212 \u03b3\u00b3", (m::ipow(GAMMA, -1) - m::ipow(GAMMA, 3)), lit<R>("1.54")));
    r.push_back(mk("R_Cl", "C_eff + \u03c0\u207b\u00b3", (C_EFF + m::ipow(PI, -3)), lit<R>("0.99")));
    r.push_back(mk("R_Fe", "\u03c6\u207b\u00b9 + \u03c8_con", (m::ipow(PHI, -1) + PSI_CON), lit<R>("1.25")));
