    out(cf(_sec, "R_F", "\u221a\u03b3 \u2212 e\u207b\u00b3", (sqrt(GAMMA) - exp((-R(3)))), T::lit("0.71")));
    out(cf(_sec, "R_Na", "\u03b3\u207b\u00b9 \u2212 \u03b3\u00b3", (ipow(GAMMA, -1) - ipow(GAMMA, 3)), T::lit("1.54")));
    out(cf(_sec, "R_Cl", "C_eff + \u03c0\u207b\u00b3", (C_EFF + ipow(PI, -3)), T::lit("0.99")));
    out(cf(_sec, "R_Fe", "\u03c6\u207b\u00b9 + \u03c8_con", (ipow(PHI, -1) + PSI_CON), T::lit("1.25")));
  }

